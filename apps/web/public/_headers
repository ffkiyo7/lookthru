# Workers Static Assets 支持 _headers（与 Pages 同语法）。
# Service Worker 与 manifest 必须 no-cache，否则用户会永远卡在旧版本 —— 见 plan「五、目录结构」
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# 带 hash 的构建产物可以长缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable
